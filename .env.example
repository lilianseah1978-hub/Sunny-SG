# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ONEMAP_EMAIL & ONEMAP_PASSWORD: Credentials for OneMap Singapore Government API v2
# Auto-authenticates and mints 3-day bearer tokens for routing, geocoding & reverse geocoding
ONEMAP_EMAIL="bernard.ngck@gmail.com"
ONEMAP_PASSWORD="Talktoroh2026!"
